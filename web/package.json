{
  "name": "brawler-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.18.0"
  },
  "scripts": {
    "wasm": "node ../tools/build-wasm.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "prebuild": "npm run wasm",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.10.2",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
